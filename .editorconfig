root = true

# Enforced in CI by `dotnet format whitespace` + `dotnet format style` with --verify-no-changes (C#) and XamlStyler (`Settings.XamlStyler`, XAML).
# end_of_line is deliberately unset: .gitattributes (text=auto) owns line endings, and CI checks out LF.
[*]
indent_style = tab

[*.cs]
insert_final_newline = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false

[*.{yml,yaml,json,md,csproj,props,slnx}]
indent_style = space
indent_size = 2
