<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>
		<key>UIRequiredDeviceCapabilities</key>
		<array>
			<string>armv7</string>
			<string>arm64</string>
		</array>

		<!--
			Spec 010 — restore Xamarin orientations.
			iPhone: portrait + portrait-upside-down only (no landscape).
			iPad: all four orientations.
		-->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>

		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<key>XSAppIconAssets</key>
		<string>Assets.xcassets/icon.appiconset</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIAppFonts</key>
		<array>
			<string>FontAwesomeSolid.otf</string>
			<string>FontAwesomeRegular.otf</string>
			<string>FontAwesomeBrands.otf</string>
		</array>

		<!--
			Spec 010 §B — explicit minimum OS, both here and in the csproj's
			SupportedOSPlatformVersion. Modern Uno requires iOS 15 baseline.
		-->
		<key>MinimumOSVersion</key>
		<string>15.0</string>

		<!--
			Spec 010 §E (superseded 2026-09, see the note at the end of the spec):
			CFBundleIdentifier, CFBundleName, CFBundleDisplayName, CFBundleShortVersionString
			and CFBundleVersion are deliberately absent: the .NET iOS SDK fills them from the
			csproj's ApplicationId / ApplicationTitle / ApplicationDisplayVersion /
			ApplicationVersion (the latter two computed by Nerdbank.GitVersioning) only when
			the key is missing. Spec 010 originally listed them here as $(...) placeholders,
			but nothing substitutes those (verified 2026-09 on the built .app / .ipa: the
			bundle shipped a literal "$(ApplicationId)"), so per the spec's own fallback
			they were removed.
		-->

		<!--
			The app is offline (embedded SQLite) and uses no non-exempt
			encryption. Declaring it here lets automated App Store Connect
			uploads skip the manual "Missing Compliance" prompt.
		-->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>
