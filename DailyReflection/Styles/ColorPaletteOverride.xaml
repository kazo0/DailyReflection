<?xml version="1.0" encoding="UTF-8" ?>
<!--
	Color palette override for Uno Material (consumed by MaterialToolkitTheme
	in App.xaml via ColorOverrideSource). Maps the Xamarin-era DR palette onto
	the full Material (v7 / MD3) color role set so adopting Material does not
	rebrand the app. Any role left undefined falls back to the default Material
	(purple) palette — which is why every role is spelled out here.
	
	Seed values from the original Xamarin.Forms app:
	Primary            #1976D2  (App.xaml PrimaryColor / Android colorPrimary)
	Primary dark       #004BA0  (Android colorPrimaryDark)
	Background         #EFF2F5 light / #121212 dark
	Text               #323130 light / #FFFFFF dark
	Secondary/tertiary/neutral roles are M3 tonal derivations of that blue seed.
	Key names follow Uno.Themes' SharedColorPalette.xaml contract.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>

		<!-- Light Theme -->
		<ResourceDictionary x:Key="Light">
			<!-- Primary -->
			<Color x:Key="PrimaryColor">#1976D2</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#BBDEFB</Color>
			<Color x:Key="OnPrimaryContainerColor">#002171</Color>
			<Color x:Key="PrimaryInverseColor">#90CAF9</Color>
			<Color x:Key="PrimaryVariantLightColor">#63A4FF</Color>
			<Color x:Key="PrimaryVariantDarkColor">#004BA0</Color>

			<!-- Secondary -->
			<Color x:Key="SecondaryColor">#535F70</Color>
			<Color x:Key="OnSecondaryColor">#FFFFFF</Color>
			<Color x:Key="SecondaryContainerColor">#D7E3F8</Color>
			<Color x:Key="OnSecondaryContainerColor">#101C2B</Color>
			<Color x:Key="SecondaryVariantLightColor">#E3ECF6</Color>
			<Color x:Key="SecondaryVariantDarkColor">#3B4858</Color>

			<!-- Tertiary -->
			<Color x:Key="TertiaryColor">#00677E</Color>
			<Color x:Key="OnTertiaryColor">#FFFFFF</Color>
			<Color x:Key="TertiaryContainerColor">#A9EDFF</Color>
			<Color x:Key="OnTertiaryContainerColor">#001F27</Color>

			<!-- Error -->
			<Color x:Key="ErrorColor">#B3261E</Color>
			<Color x:Key="OnErrorColor">#FFFFFF</Color>
			<Color x:Key="ErrorContainerColor">#F9DEDC</Color>
			<Color x:Key="OnErrorContainerColor">#410E0B</Color>

			<!-- Background -->
			<Color x:Key="BackgroundColor">#EFF2F5</Color>
			<Color x:Key="OnBackgroundColor">#323130</Color>

			<!-- Surface -->
			<Color x:Key="SurfaceColor">#FFFFFF</Color>
			<Color x:Key="OnSurfaceColor">#323130</Color>
			<Color x:Key="SurfaceVariantColor">#DFE2EB</Color>
			<Color x:Key="OnSurfaceVariantColor">#43474E</Color>
			<Color x:Key="SurfaceInverseColor">#2F3033</Color>
			<Color x:Key="OnSurfaceInverseColor">#F1F0F4</Color>
			<Color x:Key="SurfaceTintColor">#1976D2</Color>

			<!-- Outline -->
			<Color x:Key="OutlineColor">#73777F</Color>
			<Color x:Key="OutlineVariantColor">#C3C7CF</Color>

			<!-- Shadow -->
			<Color x:Key="ShadowColor">#000000</Color>
		</ResourceDictionary>

		<!-- Dark Theme -->
		<ResourceDictionary x:Key="Dark">
			<!-- Primary -->
			<Color x:Key="PrimaryColor">#1976D2</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#0D47A1</Color>
			<Color x:Key="OnPrimaryContainerColor">#BBDEFB</Color>
			<Color x:Key="PrimaryInverseColor">#1976D2</Color>
			<Color x:Key="PrimaryVariantLightColor">#63A4FF</Color>
			<Color x:Key="PrimaryVariantDarkColor">#004BA0</Color>

			<!-- Secondary -->
			<Color x:Key="SecondaryColor">#BBC7DB</Color>
			<Color x:Key="OnSecondaryColor">#253140</Color>
			<Color x:Key="SecondaryContainerColor">#3B4858</Color>
			<Color x:Key="OnSecondaryContainerColor">#D7E3F8</Color>
			<Color x:Key="SecondaryVariantLightColor">#E3ECF6</Color>
			<Color x:Key="SecondaryVariantDarkColor">#3B4858</Color>

			<!-- Tertiary -->
			<Color x:Key="TertiaryColor">#84D2E6</Color>
			<Color x:Key="OnTertiaryColor">#00363F</Color>
			<Color x:Key="TertiaryContainerColor">#004E5F</Color>
			<Color x:Key="OnTertiaryContainerColor">#A9EDFF</Color>

			<!-- Error -->
			<Color x:Key="ErrorColor">#F2B8B5</Color>
			<Color x:Key="OnErrorColor">#601410</Color>
			<Color x:Key="ErrorContainerColor">#8C1D18</Color>
			<Color x:Key="OnErrorContainerColor">#F9DEDC</Color>

			<!-- Background -->
			<Color x:Key="BackgroundColor">#121212</Color>
			<Color x:Key="OnBackgroundColor">#FFFFFF</Color>

			<!-- Surface -->
			<Color x:Key="SurfaceColor">#1E1E1E</Color>
			<Color x:Key="OnSurfaceColor">#FFFFFF</Color>
			<Color x:Key="SurfaceVariantColor">#43474E</Color>
			<Color x:Key="OnSurfaceVariantColor">#C3C7CF</Color>
			<Color x:Key="SurfaceInverseColor">#E6E9EE</Color>
			<Color x:Key="OnSurfaceInverseColor">#2F3033</Color>
			<Color x:Key="SurfaceTintColor">#90CAF9</Color>

			<!-- Outline -->
			<Color x:Key="OutlineColor">#8D9199</Color>
			<Color x:Key="OutlineVariantColor">#43474E</Color>

			<!-- Shadow -->
			<Color x:Key="ShadowColor">#000000</Color>
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
