<?xml version="1.0" encoding="UTF-8" ?>
<!--
	Color palette override for Uno Material (consumed by MaterialToolkitTheme
	in App.xaml via ColorOverrideSource). Maps the Xamarin-era DR palette onto
	the Material color keys so adopting Material does not rebrand the app:
	primary stays the original #1976D2 blue, background/surface stay the
	original page colors (#EFF2F5 light / #121212 dark, spec 004 §A).
	Keys follow the Uno Material manual color override contract:
	https://platform.uno/docs/articles/external/uno.themes/doc/material-getting-started.html
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>

		<!-- Light Theme -->
		<ResourceDictionary x:Key="Light">
			<!-- Primary -->
			<Color x:Key="PrimaryColor">#1976D2</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#BBDEFB</Color>
			<Color x:Key="OnPrimaryContainerColor">#002171</Color>
			<Color x:Key="PrimaryInverseColor">#90CAF9</Color>

			<!-- Background -->
			<Color x:Key="BackgroundColor">#EFF2F5</Color>
			<Color x:Key="OnBackgroundColor">#323130</Color>

			<!-- Surface -->
			<Color x:Key="SurfaceColor">#FFFFFF</Color>
			<Color x:Key="OnSurfaceColor">#323130</Color>
		</ResourceDictionary>

		<!-- Dark Theme -->
		<ResourceDictionary x:Key="Dark">
			<!-- Primary -->
			<Color x:Key="PrimaryColor">#1976D2</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#0D47A1</Color>
			<Color x:Key="OnPrimaryContainerColor">#BBDEFB</Color>
			<Color x:Key="PrimaryInverseColor">#90CAF9</Color>

			<!-- Background -->
			<Color x:Key="BackgroundColor">#121212</Color>
			<Color x:Key="OnBackgroundColor">#FFFFFF</Color>

			<!-- Surface -->
			<Color x:Key="SurfaceColor">#1E1E1E</Color>
			<Color x:Key="OnSurfaceColor">#FFFFFF</Color>
		</ResourceDictionary>

	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
