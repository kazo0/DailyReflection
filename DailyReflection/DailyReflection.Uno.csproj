<Project Sdk="Uno.Sdk">
  <!--
    TargetFrameworkOverride restricts the head to a subset of platforms, so a build
    only restores (and only needs the workloads for) the TFMs it actually compiles.
    CI sets it per job; locally it comes from crosstargeting_override.props at the
    repo root (see AGENTS.md, "Building a single platform").

    Values are platform suffixes, semicolon-separated: android, ios, desktop.
  -->
  <PropertyGroup Condition="'$(TargetFrameworkOverride)'!=''">
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('android'))">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('desktop'))">$(TargetFrameworks);net10.0-desktop</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFrameworkOverride)'==''">
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-desktop</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>DailyReflection</RootNamespace>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Daily Reflection</ApplicationTitle>
    <!-- App Identifier — matches the original Xamarin app so store listings
         upgrade in place (spec 011 §E resolution). -->
    <ApplicationId>com.kazo0.dailyreflection</ApplicationId>
    <!-- Versions — computed from git by Nerdbank.GitVersioning (version.json at
         the repo root; see the comment in Directory.Build.props), not hardcoded
         here. The computed ApplicationVersion must exceed the Xamarin app's
         3.4 (34) for stores to accept the binary as an upgrade; NBGV's packed
         Android versionCode for 4.x is >= 67108864. -->
    <!-- Package Publisher -->
    <ApplicationPublisher>DailyReflection</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Daily Reflection app powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
      Hosting;
      Toolkit;
      Material;
      Configuration;
      Navigation;
      Mvux;
    </UnoFeatures>
  </PropertyGroup>

  <!-- Spec 010 §B — pin iOS minimum to 15.0 to match Info.plist. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Spec 009 — Android min SDK pinned to match the Xamarin original (21).
    Runtime targetSdkVersion is set to 36 in AndroidManifest.xml (bumped from
    the Xamarin-era 33 to match the .NET 10 Android build SDK and satisfy the
    Play Store target-API requirement for updates); we intentionally do *not*
    pin TargetPlatformVersion here because Uno's AndroidX package set requires
    the newer compile target. Compile target is independent from the
    manifest's android:targetSdkVersion at runtime.
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <!-- <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <!-- Version-pin only: ExcludeAssets="all" keeps the vulnerable 2.1.2 (via sqlite-net-pcl's
         bundle_green) out of the graph while contributing no files — the native SQLite binary
         comes from SourceGear.sqlite3 via lib.e_sqlite3 3.50.x. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" ExcludeAssets="all" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference shared projects -->
    <ProjectReference Include="..\DailyReflection.Core\DailyReflection.Core.csproj" />
    <ProjectReference Include="..\DailyReflection.Data\DailyReflection.Data.csproj" />
    <ProjectReference Include="..\DailyReflection.Services\DailyReflection.Services.csproj" />
    <ProjectReference Include="..\DailyReflection.Presentation\DailyReflection.Presentation.csproj" />
  </ItemGroup>

</Project>
