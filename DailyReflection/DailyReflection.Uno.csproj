<Project Sdk="Uno.Sdk">
  <!--
    TargetFrameworkOverride restricts the head to a subset of platforms, so a build
    only restores (and only needs the workloads for) the TFMs it actually compiles.
    CI sets it per job; locally it comes from crosstargeting_override.props at the
    repo root (see AGENTS.md, "Building a single platform").

    Values are platform suffixes, semicolon-separated: android, ios, desktop, wasm.
  -->
  <PropertyGroup Condition="'$(TargetFrameworkOverride)'!=''">
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('android'))">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('ios'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('desktop'))">$(TargetFrameworks);net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$(TargetFrameworkOverride.Contains('wasm'))">$(TargetFrameworks);net10.0-browserwasm</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFrameworkOverride)'==''">
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>DailyReflection</RootNamespace>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Daily Reflection</ApplicationTitle>
    <!-- App Identifier — matches the original Xamarin app so store listings
         upgrade in place (spec 011 §E resolution). -->
    <ApplicationId>com.kazo0.dailyreflection</ApplicationId>
    <!-- Versions — computed from git by Nerdbank.GitVersioning (version.json at
         the repo root; see the comment in Directory.Build.props), not hardcoded
         here. The computed ApplicationVersion must exceed the Xamarin app's
         3.4 (34) for stores to accept the binary as an upgrade; NBGV's packed
         Android versionCode for 4.x is >= 67108864. -->
    <!-- Package Publisher -->
    <ApplicationPublisher>DailyReflection</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Daily Reflection app powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
      Hosting;
      Toolkit;
      Material;
      Configuration;
      Navigation;
      Mvux;
    </UnoFeatures>
  </PropertyGroup>

  <!-- Spec 010 §B — pin iOS minimum to 15.0 to match Info.plist. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Spec 009 — Android min SDK pinned to match the Xamarin original (21).
    Runtime targetSdkVersion is set to 36 in AndroidManifest.xml (bumped from
    the Xamarin-era 33 to match the .NET 10 Android build SDK and satisfy the
    Play Store target-API requirement for updates); we intentionally do *not*
    pin TargetPlatformVersion here because Uno's AndroidX package set requires
    the newer compile target. Compile target is independent from the
    manifest's android:targetSdkVersion at runtime.
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <!-- <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion> -->
  </PropertyGroup>

  <!--
    Native AOT for the store packages (Android + iOS) — Uno Platform 6.6+:
    https://platform.uno/docs/articles/features/native-aot.html

    Gated on _IsPublishing, which the CLI sets for 'dotnet publish' (release.yml,
    and ci.yml only for builds targeting a release/* branch). A plain
    'dotnet build' — Debug deploys, hot reload, the IDE, everyday CI — keeps the
    regular Mono/CoreCLR runtime. The iOS SDK already gates
    PublishAot on _IsPublishing itself; the Android SDK does not (it would flip
    every Debug build to NativeAOT and demand an NDK), hence the explicit check.

    Desktop stays CoreCLR: Native AOT cannot cross-compile, and release.yml
    publishes the win-x64 / linux-x64 / osx-arm64 zips from one Linux runner.

    Opt out per invocation with '-p:PublishNativeAot=false' (release.yml
    exposes that as the 'native_aot' dispatch input); the package then falls
    back to the runtime's own AOT (Mono profiled AOT on Android, Mono AOT+LLVM
    on iOS). PublishNativeAot is the "intermediate property" the Uno doc
    recommends — never pass PublishAot itself on the command line: as a global
    property it also reaches the net10.0 class libraries, which fail with
    NETSDK1203 for a mobile RuntimeIdentifier. Prerequisites: Android needs NDK r27+
    (AndroidNdkDirectory, or the SDK's ndk/ folder; the .NET SDK flags Android
    Native AOT as experimental via warning XA1040); iOS needs '-r ios-arm64'.

    IsAotCompatible turns the trim / AOT / single-file analyzers on for every
    build, including the fast desktop one, so reflection the trimmer cannot see
    is flagged at compile time rather than as a missing member on a device.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == '' And '$(_IsPublishing)' == 'true' And '$(PublishNativeAot)' != 'false' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios')">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Profile-guided AOT for the WebAssembly head:
    https://platform.uno/docs/articles/external/uno.wasm.bootstrap/doc/runtime-execution-modes.html

    Same publish gate as the mobile packages: 'dotnet publish' (web-deploy.yml, for every
    Pages slot) compiles to WebAssembly, while 'dotnet build' / 'dotnet run' keep the
    interpreter. The WebAssembly SDK does the native link and the AOT compile in a nested
    publish that clears _IsPublishing and sets _WasmIsPublishing instead, so the gate accepts
    either; with _IsPublishing alone that pass stays interpreted. InterpreterAndAOT only AOT-compiles the methods listed in
    Platforms/WebAssembly/aot.profile, which the Uno SDK picks up for every Release build; the
    rest stays interpreted, which keeps the download and the build time down. Without the
    profile the mode would AOT everything, so _RequireWasmAotProfile fails the publish instead.

    The profile is a recording of the methods app startup ran (scripts/wasm-aot-profile;
    release.yml re-records it every release). It stays startup-only because all AOT code lands
    in dotnet.native.wasm and Cloudflare Pages rejects files over 25 MiB (docs/WEB-DEPLOY.md).
    It does not have to be exact: a method missing from it is interpreted, not broken.

    Opt out per invocation with '-p:PublishWasmAot=false'. The profiling build itself
    (UnoGenerateAotProfile=true) must stay interpreted: the AOT profiler cannot trace
    AOT-compiled code, and Uno's Wasm targets would otherwise turn RunAOTCompilation on before
    the profiling targets are imported.
  -->
  <PropertyGroup Condition="('$(_IsPublishing)' == 'true' Or '$(_WasmIsPublishing)' == 'true') And '$(PublishWasmAot)' != 'false' And '$(UnoGenerateAotProfile)' != 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <WasmShellMonoRuntimeExecutionMode>InterpreterAndAOT</WasmShellMonoRuntimeExecutionMode>
  </PropertyGroup>

  <Target Name="_RequireWasmAotProfile" BeforeTargets="Build" Condition="'$(WasmShellMonoRuntimeExecutionMode)' == 'InterpreterAndAOT'">
    <Error Condition="'@(WasmShellEnableAotProfile)' == ''"
           Text="The WebAssembly AOT publish needs Platforms/WebAssembly/aot.profile (a Release build picks it up). Record it with scripts/wasm-aot-profile (docs/WEB-DEPLOY.md), or pass -p:PublishWasmAot=false to publish interpreted." />
  </Target>

  <!--
    App icon (Assets/Icons): icon_foreground.svg is the glyph on its 24-unit Material canvas,
    so this scale is the fraction of the icon that canvas covers. 0.49 reproduces the Xamarin
    iOS 1024px icon exactly (and is used for desktop). Android's adaptive icon only shows the
    middle 66 of its 108dp, so 0.30 keeps the glyph at the size of the old round launcher icon.
  -->
  <PropertyGroup>
    <UnoIconForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">0.30</UnoIconForegroundScale>
    <UnoIconForegroundScale Condition="'$(UnoIconForegroundScale)' == ''">0.49</UnoIconForegroundScale>
  </PropertyGroup>

  <!--
    Splash screen (Assets/Splash): the icon glyph in white on the same DR primary blue as the
    Xamarin splash. splash_logo.svg keeps 1 unit of margin around the 20-unit glyph, so at a
    143 base size the glyph is 130dp/pt wide, as it was on the Xamarin Android splash. The base
    size sets the iOS launch storyboard image and the pre-Android-12 window background; the
    Android 12+ splash icon is a fixed 108dp that the margin keeps inside the circular mask.

    The file is deliberately not the Uno default splash_screen.svg: its name becomes the image
    name in the iOS launch storyboard, and iOS keeps serving a cached launch image under an
    unchanged name across app updates (TestFlight builds kept showing the Uno template logo).
  -->
  <PropertyGroup>
    <UnoSplashScreenFile>Assets\Splash\splash_logo.svg</UnoSplashScreenFile>
    <UnoSplashScreenColor>#1976D2</UnoSplashScreenColor>
    <UnoSplashScreenBaseSize>143,143</UnoSplashScreenBaseSize>
  </PropertyGroup>

  <!--
    iOS launch storyboard image scales. With Uno 7's Skia renderer, Uno.Resizetizer 1.13 treats the
    iOS head as a Skia app and emits the splash as Uno runtime assets (splash_logo.scale-200.png,
    ...). UIKit's launch storyboard only understands @2x/@3x names, so it drew the 143px 1x image
    stretched and blurry on every Retina screen. Add @2x/@3x copies of the generated scales so
    UIKit picks the right one. They are copied to their own files first: the iOS SDK keeps only
    one bundle name per source file (MT7158). See unoplatform/uno.resizetizer#377.
  -->
  <Target Name="_AddAppleSplashScreenScales"
          AfterTargets="ProcessResizedImages"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '@(UnoSplashScreen)' != ''">
    <PropertyGroup>
      <_SplashImageName>@(UnoSplashScreen->'%(Filename)')</_SplashImageName>
      <_AppleSplashDir>$(IntermediateOutputPath)applesplash\</_AppleSplashDir>
    </PropertyGroup>
    <ItemGroup>
      <_AppleSplashScale Include="@(Content)" Condition="'%(Filename)%(Extension)' == '$(_SplashImageName).scale-200.png'" AppleName="$(_SplashImageName)@2x.png" />
      <_AppleSplashScale Include="@(Content)" Condition="'%(Filename)%(Extension)' == '$(_SplashImageName).scale-300.png'" AppleName="$(_SplashImageName)@3x.png" />
    </ItemGroup>
    <Warning Condition="'@(_AppleSplashScale->Count())' != '2'"
             Text="Expected the generated $(_SplashImageName).scale-200.png and .scale-300.png splash images; the iOS launch image will be blurry." />
    <ItemGroup>
      <_AppleSplashCopy Include="@(_AppleSplashScale->'$(_AppleSplashDir)%(AppleName)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppleSplashScale)" DestinationFiles="@(_AppleSplashCopy)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="@(_AppleSplashCopy)" Link="%(_AppleSplashCopy.AppleName)" TargetPath="%(_AppleSplashCopy.AppleName)" />
      <FileWrites Include="@(_AppleSplashCopy)" />
    </ItemGroup>
  </Target>

  <!--
    Multi-RID Android publish (no -r, i.e. the SDK default android-arm64;android-x64 that
    alpha.yml and release.yml rely on): the Android SDK compiles each RID in an inner build
    and packs both native libraries into the .aab, but ILCompiler's CopyNativeBinary
    (AfterTargets="Publish") also runs on the RID-less outer publish, where $(NativeBinary)
    resolves to bin/.../net10.0-android/native/DailyReflection.Uno.so — a file only the
    per-RID inner builds produce — and fails with MSB3030 (dotnet/android#10587). Blanking
    the source there turns that Copy into a no-op; the .aab is already complete by then.
    Per-RID publishes (-r android-arm64) never hit this: the outer build *is* the RID build.
  -->
  <Target Name="_SkipOuterNativeBinaryCopy" BeforeTargets="CopyNativeBinary" Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <NativeBinary />
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <!-- Version-pin only: ExcludeAssets="all" keeps the vulnerable 2.1.2 (via sqlite-net-pcl's
         bundle_green) out of the graph while contributing no files — the native SQLite binary
         comes from SourceGear.sqlite3 via lib.e_sqlite3 3.50.x. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" ExcludeAssets="all" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference shared projects -->
    <ProjectReference Include="..\DailyReflection.Core\DailyReflection.Core.csproj" />
    <ProjectReference Include="..\DailyReflection.Data\DailyReflection.Data.csproj" />
    <ProjectReference Include="..\DailyReflection.Services\DailyReflection.Services.csproj" />
    <ProjectReference Include="..\DailyReflection.Presentation\DailyReflection.Presentation.csproj" />
  </ItemGroup>

</Project>
