<Application x:Class="DailyReflection.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:converters="using:DailyReflection.Converters"
			 xmlns:utu="using:Uno.Toolkit.UI">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- Uno Material theme (also initializes the Toolkit resources). Colors are
				     overridden with the DR palette so the app keeps its Xamarin-era branding. -->
				<MaterialToolkitTheme xmlns="using:Uno.Toolkit.UI.Material" 
									  ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
				<!-- App resources -->
				<ResourceDictionary Source="ms-appx:///Styles/PickerFlyouts.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/SettingsComboBox.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- FontAwesome font families -->
			<FontFamily x:Key="FontAwesomeSolid">ms-appx:///Assets/Fonts/FontAwesomeSolid.otf#Font Awesome 5 Free Solid</FontFamily>
			<FontFamily x:Key="FontAwesomeRegular">ms-appx:///Assets/Fonts/FontAwesomeRegular.otf#Font Awesome 5 Free Regular</FontFamily>
			<FontFamily x:Key="FontAwesomeBrands">ms-appx:///Assets/Fonts/FontAwesomeBrands.otf#Font Awesome 5 Brands Regular</FontFamily>

			<!-- Font Icon Glyphs (from FontAwesome) -->
			<x:String x:Key="Calendar">&#xf073;</x:String>
			<x:String x:Key="Book">&#xf02d;</x:String>
			<x:String x:Key="Gear">&#xf013;</x:String>
			<x:String x:Key="Clock">&#xf017;</x:String>
			<x:String x:Key="Share">&#xf14d;</x:String>

			<!-- Converters (only those referenced via {StaticResource ...} in views). -->
			<converters:IntToBoolConverter x:Key="IntToBoolConverter" />
			<converters:NullToBoolConverter x:Key="NullToBoolConverter" />
			<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
			<converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"
												  Invert="True" />
			<converters:TimePickerLabelEnabledConverter x:Key="TimePickerLabelEnabledConverter" />
			<converters:DateSetToVisibilityConverter x:Key="DateSetToVisibilityConverter" />
			<converters:DateFormatConverter x:Key="PageDateConverter"
											Format="MMMM d" />
			<converters:DateFormatConverter x:Key="SoberDateConverter"
											Format="MMM d, yyyy"
											FallbackToToday="True" />
			<converters:DateFormatConverter x:Key="NotificationTimeConverter"
											Format="h:mm tt" />

		</ResourceDictionary>
	</Application.Resources>

</Application>
