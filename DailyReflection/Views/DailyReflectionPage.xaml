<?xml version="1.0" encoding="utf-8" ?>
<!--
    DailyReflectionPage
    Migrated from MAUI DailyReflectionView.xaml to WinUI/Uno Platform Page.

    - Top app bar: Uno Toolkit NavigationBar (Xamarin ToolbarItems equivalent),
      with the calendar flyout in PrimaryCommands and Share in SecondaryCommands.
    - Content: MVUX FeedView over the Reflections list feed (every reading,
      Jan 1 → Dec 31) — ValueTemplate holds a FlipView paging one reading per
      day (swipe / arrow left and right to move backward and forward), synced
      with a PipsPager through the Toolkit SelectorExtensions; ProgressTemplate
      the loading ring, None/ErrorTemplate the error text.
    - The FlipView's position is kept in step with the model's Date /
      SelectedIndex in code-behind (see DailyReflectionPage.xaml.cs).
    - The Title / Reading / Thought TextBlocks render the DB's inline HTML via
      the HtmlEx.InlinesSource attached property (spec 003).
-->
<Page x:Class="DailyReflection.Views.DailyReflectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:DailyReflection.Converters"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      AutomationProperties.AutomationId="daily_reflection_view">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <utu:NavigationBar Grid.Row="0">
            <utu:NavigationBar.Content>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource TitleLarge}"
                           Text="{Binding Date, Converter={StaticResource PageDateConverter}}" />
            </utu:NavigationBar.Content>
            <utu:NavigationBar.PrimaryCommands>
                <AppBarButton x:Name="CalendarButton"
                              Label="Select Date"
                              AutomationProperties.AutomationId="change_date">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeRegular}"
                                  Glyph="&#xf073;" />
                    </AppBarButton.Icon>
                    <!-- AutomationProperties.AutomationId for the picker is applied to the
                         owning AppBarButton above (change_date); the FlyoutBase doesn't
                         accept attached automation properties in WinUI/Uno. -->
                    <AppBarButton.Flyout>
                        <DatePickerFlyout x:Name="DatePickerFlyout"
                                          YearVisible="False"
                                          DatePicked="DatePickerFlyout_DatePicked" />
                    </AppBarButton.Flyout>
                </AppBarButton>
            </utu:NavigationBar.PrimaryCommands>
            <utu:NavigationBar.SecondaryCommands>
                <AppBarButton Label="Share"
                              Command="{Binding Share}"
                              AutomationProperties.AutomationId="share_reflection">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeRegular}"
                                  Glyph="&#xf14d;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </utu:NavigationBar.SecondaryCommands>
        </utu:NavigationBar>

        <mvux:FeedView Grid.Row="1"
                       Source="{Binding Reflections}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch">
            <!-- Value (default) template: one page per reading. -->
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <FlipView Grid.Row="0"
                              ItemsSource="{Binding Data}"
                              Background="Transparent"
                              utu:SelectorExtensions.PipsPager="{Binding ElementName=ReflectionPager}"
                              Loaded="ReflectionsFlipView_Loaded"
                              Unloaded="ReflectionsFlipView_Unloaded"
                              AutomationProperties.AutomationId="reflection_flipview">
                        <FlipView.ItemTemplate>
                            <DataTemplate>
                                <ScrollViewer>
                                    <StackPanel Margin="20">
                                        <!-- Title -->
                                        <TextBlock Style="{StaticResource HeadlineSmall}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   converters:HtmlEx.InlinesSource="{Binding Title}"
                                                   AutomationProperties.AutomationId="reflection_title" />

                                        <!-- Reading/Quote — italic at the block level so any inline italics nest as upright (matching <i> inside <i>). -->
                                        <TextBlock Margin="0,20,0,0"
                                                   FontStyle="Italic"
                                                   Style="{StaticResource BodyMedium}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   converters:HtmlEx.InlinesSource="{Binding Reading}"
                                                   AutomationProperties.AutomationId="reflection_quote" />

                                        <!-- Source -->
                                        <TextBlock Style="{StaticResource BodyMedium}"
                                                   AutomationProperties.AutomationId="reflection_quoteSource">
                                            <Run Text="— " />
                                            <Run Text="{Binding Source}" />
                                        </TextBlock>

                                        <!-- Thought -->
                                        <TextBlock Margin="0,20,0,0"
                                                   Style="{StaticResource BodyMedium}"
                                                   TextWrapping="Wrap"
                                                   converters:HtmlEx.InlinesSource="{Binding Thought}"
                                                   AutomationProperties.AutomationId="reflection_thought" />

                                        <!-- Copyright -->
                                        <TextBlock Style="{StaticResource BodySmall}"
                                                   Margin="0,20,0,0"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="reflection_copyright">
                                            <Run Text="From the book " />
                                            <Run FontStyle="Italic"
                                                 Text="Daily Reflections" />
                                            <LineBreak />
                                            <Run Text="Copyright © 1990 by Alcoholics Anonymous World Services, Inc." />
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>

                    <!-- NumberOfPages / SelectedPageIndex are driven by the FlipView
                         through SelectorExtensions.PipsPager — do not set them here. -->
                    <PipsPager x:Name="ReflectionPager"
                               Grid.Row="1"
                               Margin="0,4,0,8"
                               HorizontalAlignment="Center"
                               MaxVisiblePips="5"
                               PreviousButtonVisibility="Visible"
                               NextButtonVisibility="Visible"
                               AutomationProperties.AutomationId="reflection_pager" />
                </Grid>
            </DataTemplate>

            <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                    <ProgressRing HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="True" />
                </DataTemplate>
            </mvux:FeedView.ProgressTemplate>

            <!-- No readings loaded (service returned nothing) — the error state. -->
            <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="An error occurred. Please try again." />
                </DataTemplate>
            </mvux:FeedView.NoneTemplate>

            <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="An error occurred. Please try again." />
                </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>
    </Grid>
</Page>
