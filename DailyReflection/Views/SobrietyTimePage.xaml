<?xml version="1.0" encoding="utf-8" ?>
<!--
	SobrietyTimePage
	Migrated from MAUI SobrietyTimeView.xaml to WinUI/Uno Platform Page

	Control Mappings:
	- ContentPage -> Page
	- Label -> TextBlock
	- HorizontalOptions -> HorizontalAlignment
	- VerticalOptions -> VerticalAlignment
	- IsVisible -> Visibility (with converter)
	- StringFormat removed (use Run elements or converters)
	- x:Static -> x:Bind to static properties
-->
<Page x:Class="DailyReflection.Views.SobrietyTimePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:converters="using:DailyReflection.Converters"
	  xmlns:models="using:DailyReflection.Data.Models"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  AutomationProperties.AutomationId="sobriety_time_view"
	  >

	<Page.Resources>
		<converters:PluralityConverter x:Key="YearsPluralityConverter"
									   PluralValue="Years"
									   SingularValue="Year" />
		<converters:PluralityConverter x:Key="MonthsPluralityConverter"
									   PluralValue="Months"
									   SingularValue="Month" />
		<converters:PluralityConverter x:Key="DaysPluralityConverter"
									   PluralValue="Days"
									   SingularValue="Day" />
		<!--
			Spec 006 §D — typed enum parameter. WinUI's XAML enum parser binds
			the string "DaysMonthsYears" to the SoberTimeDisplayPreference value
			directly, so we no longer go through the DisplayPreferenceString
			indirection that bypassed compile-time checks.
		-->
		<converters:IsDisplayPreferenceToBoolConverter x:Key="IsDaysMonthsYearsDisplayPreferenceConverter"
													   DisplayPreference="DaysMonthsYears" />
		<converters:IsDisplayPreferenceToBoolConverter x:Key="IsDaysOnlyDisplayPreferenceConverter"
													   DisplayPreference="DaysOnly" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<utu:NavigationBar Grid.Row="0">
			<utu:NavigationBar.Content>
				<TextBlock VerticalAlignment="Center"
						   Style="{StaticResource SubtitleTextStyle}"
						   Text="Sober Time" />
			</utu:NavigationBar.Content>
		</utu:NavigationBar>

		<ScrollViewer Grid.Row="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="20" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Sober Date Display (hidden while no sober date is set — the feed is None) -->
			<Grid Grid.Row="1"
				  Visibility="{Binding SoberDate, Converter={StaticResource DateSetToVisibilityConverter}}"
				  AutomationProperties.AutomationId="sober_date_display">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- Calendar Icon -->
				<FontIcon FontFamily="{StaticResource FontAwesomeRegular}"
						  Glyph="&#xf073;"
						  FontSize="28"
						  HorizontalAlignment="Center" />

				<!-- Formatted Date -->
				<TextBlock Grid.Row="1"
						   Style="{StaticResource TitleTextStyle}"
						   HorizontalAlignment="Center"
						   Text="{Binding SoberDate, Converter={StaticResource SoberDateConverter}}" />
			</Grid>

			<!-- Sober Period Display (conditional based on preference) -->
			<Grid Grid.Row="3"
				  HorizontalAlignment="Center"
				  VerticalAlignment="Center"
				  Visibility="{Binding SoberDate, Converter={StaticResource DateSetToVisibilityConverter}}">

				<!-- Days/Months/Years Display Mode -->
				<Grid ColumnSpacing="16"
					  Visibility="{Binding DisplayPreference, Converter={StaticResource IsDaysMonthsYearsDisplayPreferenceConverter}}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- Years -->
					<TextBlock Style="{StaticResource TitleTextStyle}"
							   Visibility="{Binding Years, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding Years}" />
					<TextBlock Grid.Column="1"
							   Style="{StaticResource TitleTextStyle}"
							   HorizontalAlignment="Left"
							   Visibility="{Binding Years, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding Years, Converter={StaticResource YearsPluralityConverter}}" />

					<!-- Months -->
					<TextBlock Grid.Row="1"
							   Style="{StaticResource TitleTextStyle}"
							   Visibility="{Binding Months, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding Months}" />
					<TextBlock Grid.Row="1"
							   Grid.Column="1"
							   Style="{StaticResource TitleTextStyle}"
							   HorizontalAlignment="Left"
							   Visibility="{Binding Months, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding Months, Converter={StaticResource MonthsPluralityConverter}}" />

					<!-- Days -->
					<TextBlock Grid.Row="2"
							   Style="{StaticResource TitleTextStyle}"
							   Visibility="{Binding Days, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding Days}" />
					<TextBlock Grid.Row="2"
							   Grid.Column="1"
							   Style="{StaticResource TitleTextStyle}"
							   HorizontalAlignment="Left"
							   Visibility="{Binding Days, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding Days, Converter={StaticResource DaysPluralityConverter}}" />
				</Grid>

				<!-- Days Only Display Mode -->
				<Grid ColumnSpacing="16"
					  Visibility="{Binding DisplayPreference, Converter={StaticResource IsDaysOnlyDisplayPreferenceConverter}}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Style="{StaticResource TitleTextStyle}"
							   Visibility="{Binding TotalDaysSober, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding TotalDaysSober}" />
					<TextBlock Grid.Column="1"
							   Style="{StaticResource TitleTextStyle}"
							   HorizontalAlignment="Left"
							   Visibility="{Binding TotalDaysSober, Converter={StaticResource IntToBoolConverter}}"
							   Text="{Binding TotalDaysSober, Converter={StaticResource DaysPluralityConverter}}" />
				</Grid>
			</Grid>

			<!-- "One day at a time" text -->
			<TextBlock Grid.Row="4"
					   Style="{StaticResource SubtitleTextStyle}"
					   FontStyle="Italic"
					   HorizontalAlignment="Center"
					   Text="One day at a time"
					   AutomationProperties.AutomationId="sober_one_day" />
		</Grid>
		</ScrollViewer>
	</Grid>
</Page>
