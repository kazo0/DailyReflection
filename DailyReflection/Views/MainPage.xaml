<?xml version="1.0" encoding="utf-8" ?>
<!--
	MainPage - Responsive navigation shell using Uno.Extensions.Navigation regions.
	
	Two TabBars are region-attached with the same Region.Name values, so they drive
	the one content region (Visibility navigator) between them:
	- narrow windows (phones): the bottom TabBar, as before;
	- larger windows (desktop / tablet): a vertical TabBar rail on the left.
	
	The switch is done with the Toolkit's {utu:Responsive} markup extension rather than
	a VisualStateManager: it re-evaluates the property as the window resizes, and both
	controls stay in the visual tree so their regions never have to re-attach. A
	ResponsiveView is deliberately not used here — it swaps whole templates, which would
	tear down and rebuild the region-attached controls on every breakpoint change.
-->
<Page x:Class="DailyReflection.Views.MainPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:uen="using:Uno.Extensions.Navigation.UI"
	  xmlns:utu="using:Uno.Toolkit.UI">
	<Page.Resources>
		<!--
			Breakpoint for this shell. The Toolkit default promotes "Normal" at 600px,
			which a phone in landscape already exceeds; 700 keeps phones on the bottom
			TabBar in both orientations and matches Uno's responsive-shell docs.
		-->
		<utu:ResponsiveLayout x:Key="ShellResponsiveLayout"
							  Narrow="0"
							  Normal="700" />
	</Page.Resources>

	<Grid uen:Region.Attached="True"
		  ColumnDefinitions="Auto, *"
		  RowDefinitions="*, Auto">
		<!--
			Side rail - wide windows only. Items mirror the bottom TabBar: same
			Region.Name, same icons.
		-->
		<utu:TabBar x:Name="SideTabs"
					Grid.Column="0"
					Grid.RowSpan="2"
					uen:Region.Attached="True"
					Style="{StaticResource VerticalTabBarStyle}"
					Visibility="{utu:Responsive Layout={StaticResource ShellResponsiveLayout},
												Narrow=Collapsed,
												Normal=Visible}">
			<utu:TabBarItem uen:Region.Name="Reflection"
							Content="Reflection"
							AutomationProperties.AutomationId="side_tab_reflection">
				<utu:TabBarItem.Icon>
					<FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
							  Glyph="&#xf02d;" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem uen:Region.Name="SoberTime"
							Content="Sober Time"
							AutomationProperties.AutomationId="side_tab_sober_time">
				<utu:TabBarItem.Icon>
					<FontIcon FontFamily="{StaticResource FontAwesomeRegular}"
							  Glyph="&#xf017;" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem uen:Region.Name="Settings"
							Content="Settings"
							AutomationProperties.AutomationId="side_tab_settings">
				<utu:TabBarItem.Icon>
					<FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
							  Glyph="&#xf013;" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
		</utu:TabBar>

		<!--
			Tab content region - Uno.Extensions.Navigation loads the matching nested
			route's view here and toggles visibility on tab change. Stays empty in
			XAML: the framework injects the views.
		-->
		<Grid Grid.Column="1"
			  Grid.Row="0"
			  uen:Region.Attached="True"
			  uen:Region.Navigator="Visibility" />

		<!-- Bottom TabBar - narrow windows only. -->
		<utu:TabBar x:Name="BottomTabs"
					Grid.Column="1"
					Grid.Row="1"
					uen:Region.Attached="True"
					Style="{StaticResource BottomTabBarStyle}"
					Visibility="{utu:Responsive Layout={StaticResource ShellResponsiveLayout},
												Narrow=Visible,
												Normal=Collapsed}">
			<utu:TabBarItem uen:Region.Name="Reflection"
							Content="Reflection"
							AutomationProperties.AutomationId="Reflection">
				<utu:TabBarItem.Icon>
					<FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
							  Glyph="&#xf02d;" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem uen:Region.Name="SoberTime"
							Content="Sober Time"
							AutomationProperties.AutomationId="Sober Time">
				<utu:TabBarItem.Icon>
					<FontIcon FontFamily="{StaticResource FontAwesomeRegular}"
							  Glyph="&#xf017;" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem uen:Region.Name="Settings"
							Content="Settings"
							AutomationProperties.AutomationId="Settings">
				<utu:TabBarItem.Icon>
					<FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
							  Glyph="&#xf013;" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
		</utu:TabBar>
	</Grid>
</Page>
