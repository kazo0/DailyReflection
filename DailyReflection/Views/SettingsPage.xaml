<?xml version="1.0" encoding="utf-8" ?>
<!--
	SettingsPage
	Migrated from MAUI SettingsView.xaml to WinUI/Uno Platform Page

	Control Mappings:
	- ContentPage -> Page
	- TableView/TableSection -> StackPanel with headers (no direct equivalent)
	- SwitchCell -> ToggleSwitch
	- TextCell -> Custom layout with TextBlock
	- Picker -> ComboBox
	- DatePicker -> DatePickerFlyout
	- TimePicker -> TimePicker
-->
<Page x:Class="DailyReflection.Views.SettingsPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:converters="using:DailyReflection.Converters"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  AutomationProperties.AutomationId="settings_view"
	  >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<utu:NavigationBar Grid.Row="0">
			<utu:NavigationBar.Content>
				<TextBlock VerticalAlignment="Center"
						   Style="{StaticResource SubtitleTextStyle}"
						   Text="Settings" />
			</utu:NavigationBar.Content>
		</utu:NavigationBar>

		<ScrollViewer Grid.Row="1">
		<StackPanel Margin="16"
					Spacing="8">

			<!-- Daily Notifications Section -->
			<TextBlock Text="Daily Notifications"
					   Style="{StaticResource SubtitleTextStyle}"
					   Margin="0,0,0,8" />

			<!-- Enable Notifications Toggle -->
			<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
									HorizontalAlignment="Stretch"
									Padding="16,12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock Text="Enable Notifications"
							   VerticalAlignment="Center"
							   Style="{StaticResource BodyTextStyle}" />
					<ToggleSwitch Grid.Column="1"
								  IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"
								  IsEnabled="{Binding NotificationsSupported}"
								  AutomationProperties.AutomationId="settings_enable_notif_cell"
								  Margin="0" />
				</Grid>
			</utu:CardContentControl>

			<!-- Caption shown only on platforms where notifications cannot fire (spec 002). -->
			<TextBlock Text="Notifications aren't supported on this platform. The reflection will still load when the app is open."
					   Style="{StaticResource CaptionTextStyle}"
					   TextWrapping="Wrap"
					   Margin="16,0,16,8"
					   Visibility="{Binding NotificationsSupported, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

			<!--
				Notification Time. The Android target uses TimePickerLabelEnabledConverter
				to keep the row tappable even when notifications are off (matching the
				Xamarin original); iOS / desktop blocks taps via IsHitTestVisible.
			-->
			<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
									HorizontalAlignment="Stretch"
									Padding="16,12"
									IsHitTestVisible="{Binding NotificationsEnabled, Converter={StaticResource TimePickerLabelEnabledConverter}}"
									Tapped="NotificationTime_Tapped"
									AutomationProperties.AutomationId="settings_notification_time">
				<FlyoutBase.AttachedFlyout>
					<TimePickerFlyout x:Name="NotificationTimeFlyout"
									  TimePicked="NotificationTimeFlyout_TimePicked"
									  Opened="PickerFlyout_Opened"
									  LightDismissOverlayMode="On"
									  AutomationProperties.AutomationId="settings_time_picker" />
				</FlyoutBase.AttachedFlyout>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Time"
								   Style="{StaticResource BodyTextStyle}" />
						<TextBlock Text="{Binding NotificationTime, Converter={StaticResource NotificationTimeConverter}}"
								   Style="{StaticResource CaptionTextStyle}"
								   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
					<FontIcon Grid.Column="1"
							  Glyph="&#xE76C;"
							  FontSize="14"
							  VerticalAlignment="Center"
							  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</utu:CardContentControl>

			<!-- Sobriety Time Section -->
			<TextBlock Text="Sobriety Time"
					   Style="{StaticResource SubtitleTextStyle}"
					   Margin="0,16,0,8" />

			<!-- Sober Date -->
			<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
									HorizontalAlignment="Stretch"
									Padding="16,12"
									Tapped="SoberDate_Tapped"
									AutomationProperties.AutomationId="settings_sober_date">
				<FlyoutBase.AttachedFlyout>
					<DatePickerFlyout x:Name="SoberDateFlyout"
									  DatePicked="SoberDateFlyout_DatePicked"
									  Opened="PickerFlyout_Opened"
									  LightDismissOverlayMode="On"
									  AutomationProperties.AutomationId="settings_date_picker" />
				</FlyoutBase.AttachedFlyout>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Sober Date"
								   Style="{StaticResource BodyTextStyle}" />
						<TextBlock Text="{Binding SoberDate, Converter={StaticResource SoberDateConverter}}"
								   Style="{StaticResource CaptionTextStyle}"
								   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
					<FontIcon Grid.Column="1"
							  Glyph="&#xE76C;"
							  FontSize="14"
							  VerticalAlignment="Center"
							  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</utu:CardContentControl>

			<!-- Sober Time Display Preference -->
			<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
									HorizontalAlignment="Stretch"
									Padding="16,12"
									Tapped="SoberTimeDisplay_Tapped"
									AutomationProperties.AutomationId="settings_sober_time_display">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Sober Time Display"
								   Style="{StaticResource BodyTextStyle}" />
						<TextBlock Text="{Binding SoberTimeDisplayPreference, Converter={StaticResource SoberTimeDisplayEnumConverter}}"
								   Style="{StaticResource CaptionTextStyle}"
								   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
					<FontIcon Grid.Column="1"
							  Glyph="&#xE76C;"
							  FontSize="14"
							  VerticalAlignment="Center"
							  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</utu:CardContentControl>

			<!-- Hidden ComboBox for display preference -->
			<ComboBox x:Name="SoberTimeDisplayComboBox"
					  Visibility="Collapsed"
					  ItemsSource="{Binding AllSoberTimeDisplayPreferences}"
					  SelectedItem="{Binding SoberTimeDisplayPreference, Mode=TwoWay}"
					  SelectionChanged="SoberTimeDisplayComboBox_SelectionChanged">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Converter={StaticResource SoberTimeDisplayEnumConverter}}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<!-- App Version -->
			<TextBlock Text="About"
					   Style="{StaticResource SubtitleTextStyle}"
					   Margin="0,16,0,8" />

			<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
									HorizontalAlignment="Stretch"
									Padding="16,12">
				<StackPanel>
					<TextBlock Text="Version"
							   Style="{StaticResource BodyTextStyle}" />
					<TextBlock Text="{Binding AppVersion}"
							   Style="{StaticResource CaptionTextStyle}"
							   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>
			</utu:CardContentControl>
		</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
