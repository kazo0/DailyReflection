<?xml version="1.0" encoding="utf-8" ?>
<!--
	SettingsPage
	Migrated from MAUI SettingsView.xaml to WinUI/Uno Platform Page
	
	Control Mappings:
	- ContentPage -> Page
	- TableView/TableSection -> StackPanel with headers (no direct equivalent)
	- SwitchCell -> ToggleSwitch
	- TextCell -> Custom layout with TextBlock
	- Picker -> ComboBox
	- DatePicker -> DatePicker (Styles/SettingsRows.xaml)
	- TimePicker -> TimePicker (Styles/SettingsRows.xaml)
-->
<Page x:Class="DailyReflection.Views.SettingsPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:converters="using:DailyReflection.Converters"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  AutomationProperties.AutomationId="settings_view">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<utu:NavigationBar Grid.Row="0">
			<utu:NavigationBar.Content>
				<TextBlock VerticalAlignment="Center"
						   Style="{StaticResource TitleLarge}"
						   Text="Settings" />
			</utu:NavigationBar.Content>
		</utu:NavigationBar>

		<ScrollViewer Grid.Row="1">
			<StackPanel Margin="16"
						Spacing="8">

				<!--
					Daily Notifications. The whole section is hidden on platforms with no
					notification scheduler (Skia macOS / Linux desktop) — enabling a daily
					reminder that can never fire is worse than not offering it (spec 002 §B).
				-->
				<StackPanel Spacing="8"
							Visibility="{Binding NotificationsSupported, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock Text="Daily Notifications"
							   Style="{StaticResource TitleLarge}"
							   Margin="0,0,0,8" />

					<!-- Enable Notifications Toggle -->
					<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
											HorizontalAlignment="Stretch"
											Padding="16,12">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="Enable Notifications"
									   VerticalAlignment="Center"
									   Style="{StaticResource BodyMedium}" />
							<ToggleSwitch Grid.Column="1"
										  IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"
										  AutomationProperties.AutomationId="settings_enable_notif_cell"
										  Margin="0" />
						</Grid>
					</utu:CardContentControl>

					<!--
						Notification Time: a real TimePicker templated like the card rows
						(Styles/SettingsRows.xaml). The Android target uses
						TimePickerLabelEnabledConverter to keep the row tappable even when
						notifications are off (matching the Xamarin original); iOS / desktop
						block taps via IsHitTestVisible.
					-->
					<TimePicker x:Name="NotificationTimePicker"
								Style="{StaticResource DRSettingsTimePickerStyle}"
								Header="Time"
								SelectedTime="{Binding NotificationTime, Mode=TwoWay, Converter={StaticResource TimeOfDayConverter}}"
								IsHitTestVisible="{Binding NotificationsEnabled, Converter={StaticResource TimePickerLabelEnabledConverter}}"
								AutomationProperties.AutomationId="settings_notification_time">
						<!-- The control creates the presenter itself; this is where its spec-005 selector goes. -->
						<TimePicker.FlyoutPresenterStyle>
							<Style TargetType="TimePickerFlyoutPresenter"
								   BasedOn="{StaticResource DRTimePickerFlyoutPresenterStyle}">
								<Setter Property="AutomationProperties.AutomationId" Value="settings_time_picker" />
							</Style>
						</TimePicker.FlyoutPresenterStyle>
					</TimePicker>
				</StackPanel>

				<!-- Readings Section -->
				<TextBlock Text="Readings"
						   Style="{StaticResource TitleLarge}"
						   Margin="0,16,0,8" />

				<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
										HorizontalAlignment="Stretch"
										Padding="16,12">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel>
							<TextBlock Text="Secular Readings"
									   Style="{StaticResource BodyMedium}" />
							<TextBlock Text="Show readings from Beyond Belief instead of Daily Reflections."
									   Style="{StaticResource BodySmall}"
									   TextWrapping="Wrap"
									   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						</StackPanel>
						<ToggleSwitch Grid.Column="1"
									  VerticalAlignment="Center"
									  IsOn="{Binding SecularReadings, Mode=TwoWay}"
									  AutomationProperties.AutomationId="settings_secular_readings"
									  Margin="0" />
					</Grid>
				</utu:CardContentControl>

				<!-- Sobriety Time Section -->
				<TextBlock Text="Sobriety Time"
						   Style="{StaticResource TitleLarge}"
						   Margin="0,16,0,8" />

				<!-- Sober Date: a real DatePicker templated like the card rows (Styles/SettingsRows.xaml). -->
				<DatePicker x:Name="SoberDatePicker"
							Style="{StaticResource DRSettingsDatePickerStyle}"
							Header="Sober Date"
							SelectedDate="{Binding SoberDate, Mode=TwoWay}"
							MaxYear="{Binding MaxDate}"
							AutomationProperties.AutomationId="settings_sober_date">
					<!-- The control creates the presenter itself; this is where its spec-005 selector goes. -->
					<DatePicker.FlyoutPresenterStyle>
						<Style TargetType="DatePickerFlyoutPresenter"
							   BasedOn="{StaticResource DRDatePickerFlyoutPresenterStyle}">
							<Setter Property="AutomationProperties.AutomationId" Value="settings_date_picker" />
						</Style>
					</DatePicker.FlyoutPresenterStyle>
				</DatePicker>

				<!-- Sober Time Display Preference: a real ComboBox templated like the card rows (Styles/SettingsRows.xaml). -->
				<ComboBox Style="{StaticResource DRSettingsComboBoxStyle}"
						  Header="Sober Time Display"
						  ItemsSource="{Binding AllSoberTimeDisplayPreferences}"
						  SelectedItem="{Binding SoberTimeDisplayPreference, Mode=TwoWay}"
						  AutomationProperties.AutomationId="settings_sober_time_display">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Converter={StaticResource SoberTimeDisplayEnumConverter}}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!--
					App Version — tapping the card copies it (CopyVersion command) and
					shows the toast declared after the ScrollViewer.
				-->
				<TextBlock Text="About"
						   Style="{StaticResource TitleLarge}"
						   Margin="0,16,0,8" />

				<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
										HorizontalAlignment="Stretch"
										Padding="16,12"
										utu:CommandExtensions.Command="{Binding CopyVersion}"
										AutomationProperties.AutomationId="settings_version">
					<StackPanel>
						<TextBlock Text="Version"
								   Style="{StaticResource BodyMedium}" />
						<TextBlock Text="{Binding AppVersion}"
								   Style="{StaticResource BodySmall}"
								   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
				</utu:CardContentControl>

				<!-- Support call to action — opens a dialog that links to Buy Me a Coffee. -->
				<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}"
										HorizontalAlignment="Stretch"
										Padding="16,12"
										Tapped="SupportMe_Tapped"
										AutomationProperties.AutomationId="settings_support_me">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock Text="Support Me!"
								   VerticalAlignment="Center"
								   Style="{StaticResource BodyMedium}" />
						<FontIcon Grid.Column="1"
								  Glyph="&#xE76C;"
								  FontSize="14"
								  VerticalAlignment="Center"
								  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</Grid>
				</utu:CardContentControl>
			</StackPanel>
		</ScrollViewer>

		<!--
			"Version copied" toast — Material snackbar colours, over the content;
			CopyVersion holds VersionCopied true for a couple of seconds.
		-->
		<Border Grid.Row="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Bottom"
				Margin="16,0,16,24"
				Padding="16,12"
				CornerRadius="4"
				Background="{ThemeResource SurfaceInverseBrush}"
				Visibility="{Binding VersionCopied, Converter={StaticResource BoolToVisibilityConverter}}"
				AutomationProperties.AutomationId="settings_version_copied">
			<TextBlock Text="Version copied to clipboard"
					   Style="{StaticResource BodyMedium}"
					   Foreground="{ThemeResource OnSurfaceInverseBrush}" />
		</Border>
	</Grid>
</Page>
